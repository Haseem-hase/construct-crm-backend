// Study: Store reusable role templates, either global or owned by an organization.
model Role {
  // Study: Identify each record by its primary key of type String and default to uuid(.
  id String @id @default(uuid())

  // Study: Store name as a String.
  name        String
  // Study: Store description as a nullable String.
  description String?

  // true  = global role created by SUPER_ADMIN
  // false = custom role created by ORGANIZATION_OWNER
  // Study: Store is global as a Boolean and default to true.
  isGlobal Boolean @default(true)

  // NULL for global roles.
  // Set for organization-specific custom roles.
  // Study: Store organization id as a nullable String.
  organizationId String?
  // Study: Relate this record to Organization using organizationId → id when present and delete dependent records when the referenced record is deleted.
  organization   Organization? @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  // Study: Store created at as a DateTime and default to now(.
  createdAt DateTime @default(now())
  // Study: Let Prisma update this timestamp when it updates the record.
  updatedAt DateTime @updatedAt

  // Study: Expose the related OrganizationRole records through this list.
  organizationRoles OrganizationRole[]

  // Study: Require the combination [name, organizationId] to be unique.
  @@unique([name, organizationId])
  // Study: Create a database index for [organizationId] to support queries.
  @@index([organizationId])
  // Study: Use "roles" as the database name for this Prisma model.
  @@map("roles")
// Study: End the Role model.
}

// Study: Make a role available within a particular organization.
