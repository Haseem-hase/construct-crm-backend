// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

/////////////////////////////////////////////////
// AUTHENTICATION
/////////////////////////////////////////////////

/////////////////////////////////////////////////
// ROLES
/////////////////////////////////////////////////

model Role {
  id String @id @default(uuid())

  name        String
  description String?

  // true  = global role created by SUPER_ADMIN
  // false = custom role created by ORGANIZATION_OWNER
  isGlobal Boolean @default(true)

  // NULL for global roles.
  // Set for organization-specific custom roles.
  organizationId String?
  organization   Organization? @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  organizationRoles OrganizationRole[]

  @@unique([name, organizationId])
  @@index([organizationId])
  @@map("roles")
}

model OrganizationRole {
  id String @id @default(uuid())

  organizationId String
  roleId         String

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  role Role @relation(fields: [roleId], references: [id], onDelete: Cascade)

  users User[]

  rolePermissions RolePermission[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([organizationId, roleId])
  @@index([organizationId])
  @@index([roleId])
  @@map("organization_roles")
}

enum Module {
  PROJECT
  LABOUR
  COMPANY
  CUSTOMER
  ATTENDANCE
  PAYROLL
  INVENTORY
  SUPPLIER
  REPORT
  ROLE
  USER
  CONTRACTOR
}

enum Action {
  CREATE
  VIEW
  UPDATE
  DELETE
  APPROVE
  EXPORT
  ASSIGN
}

model Permission {
  id String @id @default(uuid())

  module Module
  action Action

  description String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  rolePermissions RolePermission[]

  @@unique([module, action])
  @@map("permissions")
}

model RolePermission {
  id String @id @default(uuid())

  organizationRoleId String
  permissionId       String

  organizationRole OrganizationRole @relation(fields: [organizationRoleId], references: [id], onDelete: Cascade)

  permission Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@unique([organizationRoleId, permissionId])
  @@index([organizationRoleId])
  @@index([permissionId])
  @@map("role_permissions")
}

enum UserStatus {
  ACTIVE
  INACTIVE
  SUSPENDED
  PENDING
}

enum SystemRole {
  SUPER_ADMIN
}

model User {
  id String @id @default(uuid())

  fullName  String
  avatarUrl String?

  email String  @unique
  phone String? @unique

  password String

  status UserStatus @default(ACTIVE)

  emailVerified Boolean @default(false)
  phoneVerified Boolean @default(false)

  lastLoginAt DateTime?

  systemRole SystemRole?

  organizationId String?
  organization   Organization? @relation(fields: [organizationId], references: [id])

  organizationRoleId String?
  organizationRole   OrganizationRole? @relation(fields: [organizationRoleId], references: [id])

  refreshTokens RefreshToken[]

  projectMemberships                ProjectMember[]
  inventoryRequestsCreated          InventoryRequest[]         @relation("InventoryRequestCreator")
  inventoryRequestsReviewed         InventoryRequest[]         @relation("InventoryRequestReviewer")
  inventoryReturnsCreated           InventoryReturnRequest[]   @relation("InventoryReturnCreator")
  inventoryReturnsReviewed          InventoryReturnRequest[]   @relation("InventoryReturnReviewer")
  inventoryConditionReportsCreated  InventoryConditionReport[] @relation("InventoryConditionReporter")
  inventoryConditionReportsReviewed InventoryConditionReport[] @relation("InventoryConditionReviewer")
  inventoryMovements                InventoryStockMovement[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("users")
}

model RefreshToken {
  id String @id @default(uuid())

  token String @unique

  expiresAt DateTime
  revokedAt DateTime?

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@map("refresh_tokens")
}

/////////////////////////////////////////////////
// ORGANIZATION
/////////////////////////////////////////////////

model Organization {
  id          String  @id @default(uuid())
  name        String
  description String?

  users             User[]
  roles             Role[]
  organizationRoles OrganizationRole[]
  customers         Customer[]
  projects          Project[]
  labours           Labour[]
  contractors       Contractor[]

  inventoryAssets           InventoryAsset[]
  inventoryWarehouses       InventoryWarehouse[]
  inventoryRequests         InventoryRequest[]
  inventoryReturns          InventoryReturnRequest[]
  inventoryConditionReports InventoryConditionReport[]
  inventoryMovements        InventoryStockMovement[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("organizations")
}

enum CustomerType {
  COMPANY
  GOVERNMENT
  INDIVIDUAL
  OTHER
}

/////////////////////////////////////////////////
// CUSTOMER
/////////////////////////////////////////////////

model Customer {
  id String @id @default(uuid())

  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  customerCode String @unique @default(dbgenerated("('CUS-'::text || lpad((nextval('customer_code_seq'::regclass))::text, 3, '0'::text))"))

  name            String
  type            CustomerType
  profileImageUrl String?

  country String
  city    String
  address String?

  parentCustomerId String?
  parentCustomer   Customer?  @relation("CustomerHierarchy", fields: [parentCustomerId, organizationId], references: [id, organizationId], onDelete: Cascade)
  childCustomers   Customer[] @relation("CustomerHierarchy")

  isActive Boolean @default(true)

  projectCustomers ProjectCustomer[]
  contacts         CustomerContact[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([id, organizationId])
  @@index([organizationId])
  @@index([parentCustomerId])
  @@map("customers")
}

model CustomerContact {
  id String @id @default(uuid())

  customerId String
  customer   Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)

  name            String
  designation     String
  phone           String
  otherPhone      String?
  email           String
  profileImageUrl String?
  isPrimary       Boolean @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([customerId])
  @@map("customer_contacts")
}

/////////////////////////////////////////////////
// PROJECT
/////////////////////////////////////////////////

enum ProjectStatus {
  PLANNING
  ACTIVE
  ON_HOLD
  COMPLETED
  CANCELLED
}

model Project {
  id String @id @default(uuid())

  projectCode String  @unique @default(dbgenerated("('PROJ-'::text || lpad((nextval('project_code_seq'::regclass))::text, 6, '0'::text))"))
  name        String
  description String?
  imageUrl    String?

  status ProjectStatus @default(PLANNING)

  // Organization that owns/manages the project
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)

  // Location
  country   String
  city      String?
  address   String?
  latitude  Decimal? @db.Decimal(10, 7)
  longitude Decimal? @db.Decimal(10, 7)

  // Timeline
  plannedStartDate DateTime?
  plannedEndDate   DateTime?
  actualStartDate  DateTime?
  actualEndDate    DateTime?

  // Progress
  progress Int @default(0)

  // Financial
  budget Decimal? @db.Decimal(15, 2)

  projectCustomers ProjectCustomer[]
  images           ProjectImage[]

  members               ProjectMember[]
  contractorAssignments ContractorProjectAssignment[]
  inventoryRequests     InventoryRequest[]
  inventoryWarehouses   InventoryWarehouse[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([id, organizationId])
  @@index([organizationId])
  @@index([status])
  @@map("projects")
}

model ProjectImage {
  id        String   @id @default(uuid())
  projectId String
  project   Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  imageUrl  String
  alt       String?
  isCover   Boolean  @default(false)
  position  Int      @default(0)
  createdAt DateTime @default(now())

  @@index([projectId, position])
  @@map("project_images")
}

/////////////////////////////////////////////////
// SIMPLE INVENTORY
/////////////////////////////////////////////////

enum InventoryAssetType {
  MATERIAL
  TOOL
  MACHINERY
}

model InventoryAsset {
  id             String             @id @default(uuid())
  organizationId String
  organization   Organization       @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  type           InventoryAssetType
  code           String
  name           String
  quantity       Decimal            @default(0) @db.Decimal(18, 4)
  price          Decimal            @default(0) @db.Decimal(18, 4)
  description    String?
  imageUrl       String?
  isActive       Boolean            @default(true)
  createdAt      DateTime           @default(now())
  updatedAt      DateTime           @updatedAt

  warehouseStocks  InventoryWarehouseStock[]
  requestLines     InventoryRequestLine[]
  stockMovements   InventoryStockMovement[]
  conditionReports InventoryConditionReport[]

  @@unique([organizationId, code])
  @@index([organizationId, type, isActive])
  @@index([organizationId, name])
  @@map("inventory_assets")
}

enum InventoryWarehouseType {
  CENTRAL
  PROJECT_SITE
}

enum InventoryRequestStatus {
  SUBMITTED
  APPROVED
  REJECTED
  ISSUED
  PARTIALLY_RETURNED
  RETURNED
  CANCELLED
}

enum InventoryReturnStatus {
  SUBMITTED
  APPROVED
  REJECTED
  RECEIVED
  CANCELLED
}

enum InventoryConditionReportStatus {
  SUBMITTED
  UNDER_REVIEW
  IN_REPAIR
  RESOLVED
  WRITTEN_OFF
}

enum InventoryStockMovementType {
  RECEIPT
  ISSUE
  RETURN
  DAMAGE_OUT
  REPAIR_IN
  ADJUSTMENT_IN
  ADJUSTMENT_OUT
}

model InventoryWarehouse {
  id             String                 @id @default(uuid())
  organizationId String
  organization   Organization           @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  code           String
  name           String
  type           InventoryWarehouseType @default(CENTRAL)
  projectId      String?
  project        Project?               @relation(fields: [projectId], references: [id], onDelete: Restrict)
  address        String?
  isDefault      Boolean                @default(false)
  isActive       Boolean                @default(true)
  createdAt      DateTime               @default(now())
  updatedAt      DateTime               @updatedAt

  stocks            InventoryWarehouseStock[]
  inventoryRequests InventoryRequest[]
  inventoryReturns  InventoryReturnRequest[]
  conditionReports  InventoryConditionReport[]
  stockMovements    InventoryStockMovement[]

  @@unique([organizationId, code])
  @@index([organizationId, isActive])
  @@map("inventory_warehouses")
}

model InventoryWarehouseStock {
  id             String             @id @default(uuid())
  organizationId String
  assetId        String
  asset          InventoryAsset     @relation(fields: [assetId], references: [id], onDelete: Cascade)
  warehouseId    String
  warehouse      InventoryWarehouse @relation(fields: [warehouseId], references: [id], onDelete: Cascade)
  onHandQty      Decimal            @default(0) @db.Decimal(18, 4)
  reservedQty    Decimal            @default(0) @db.Decimal(18, 4)
  maintenanceQty Decimal            @default(0) @db.Decimal(18, 4)
  createdAt      DateTime           @default(now())
  updatedAt      DateTime           @updatedAt

  @@unique([organizationId, assetId, warehouseId])
  @@index([organizationId, warehouseId])
  @@index([organizationId, assetId])
  @@map("inventory_warehouse_stocks")
}

model InventoryRequest {
  id                             String                 @id @default(uuid())
  organizationId                 String
  organization                   Organization           @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  referenceNumber                String
  warehouseId                    String
  warehouse                      InventoryWarehouse     @relation(fields: [warehouseId], references: [id], onDelete: Restrict)
  projectId                      String
  project                        Project                @relation(fields: [projectId], references: [id], onDelete: Restrict)
  requestedForLabourAssignmentId String?
  requestedForLabourAssignment   LabourAssignment?      @relation(fields: [requestedForLabourAssignmentId], references: [id], onDelete: Restrict)
  requestedById                  String
  requestedBy                    User                   @relation("InventoryRequestCreator", fields: [requestedById], references: [id], onDelete: Restrict)
  reviewedById                   String?
  reviewedBy                     User?                  @relation("InventoryRequestReviewer", fields: [reviewedById], references: [id], onDelete: Restrict)
  status                         InventoryRequestStatus @default(SUBMITTED)
  purpose                        String?
  reviewNote                     String?
  submittedAt                    DateTime               @default(now())
  reviewedAt                     DateTime?
  issuedAt                       DateTime?
  createdAt                      DateTime               @default(now())
  updatedAt                      DateTime               @updatedAt

  lines            InventoryRequestLine[]
  returns          InventoryReturnRequest[]
  conditionReports InventoryConditionReport[]
  stockMovements   InventoryStockMovement[]

  @@unique([organizationId, referenceNumber])
  @@index([organizationId, status, submittedAt])
  @@index([organizationId, projectId])
  @@index([organizationId, requestedForLabourAssignmentId])
  @@map("inventory_requests")
}

model InventoryRequestLine {
  id             String           @id @default(uuid())
  organizationId String
  requestId      String
  request        InventoryRequest @relation(fields: [requestId], references: [id], onDelete: Cascade)
  assetId        String
  asset          InventoryAsset   @relation(fields: [assetId], references: [id], onDelete: Restrict)
  requestedQty   Decimal          @db.Decimal(18, 4)
  approvedQty    Decimal?         @db.Decimal(18, 4)
  issuedQty      Decimal          @default(0) @db.Decimal(18, 4)
  returnedQty    Decimal          @default(0) @db.Decimal(18, 4)
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt

  returnLines      InventoryReturnLine[]
  conditionReports InventoryConditionReport[]
  stockMovements   InventoryStockMovement[]

  @@index([organizationId, requestId])
  @@map("inventory_request_lines")
}

model InventoryReturnRequest {
  id              String                @id @default(uuid())
  organizationId  String
  organization    Organization          @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  referenceNumber String
  requestId       String
  request         InventoryRequest      @relation(fields: [requestId], references: [id], onDelete: Restrict)
  warehouseId     String
  warehouse       InventoryWarehouse    @relation(fields: [warehouseId], references: [id], onDelete: Restrict)
  requestedById   String
  requestedBy     User                  @relation("InventoryReturnCreator", fields: [requestedById], references: [id], onDelete: Restrict)
  reviewedById    String?
  reviewedBy      User?                 @relation("InventoryReturnReviewer", fields: [reviewedById], references: [id], onDelete: Restrict)
  status          InventoryReturnStatus @default(SUBMITTED)
  reviewNote      String?
  submittedAt     DateTime              @default(now())
  reviewedAt      DateTime?
  receivedAt      DateTime?
  createdAt       DateTime              @default(now())
  updatedAt       DateTime              @updatedAt

  lines          InventoryReturnLine[]
  stockMovements InventoryStockMovement[]

  @@unique([organizationId, referenceNumber])
  @@index([organizationId, status, submittedAt])
  @@map("inventory_return_requests")
}

model InventoryReturnLine {
  id              String                 @id @default(uuid())
  organizationId  String
  returnRequestId String
  returnRequest   InventoryReturnRequest @relation(fields: [returnRequestId], references: [id], onDelete: Cascade)
  requestLineId   String
  requestLine     InventoryRequestLine   @relation(fields: [requestLineId], references: [id], onDelete: Restrict)
  quantity        Decimal                @db.Decimal(18, 4)
  condition       String?
  createdAt       DateTime               @default(now())
  updatedAt       DateTime               @updatedAt

  @@index([organizationId, returnRequestId])
  @@map("inventory_return_lines")
}

model InventoryConditionReport {
  id             String                         @id @default(uuid())
  organizationId String
  organization   Organization                   @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  assetId        String
  asset          InventoryAsset                 @relation(fields: [assetId], references: [id], onDelete: Restrict)
  warehouseId    String
  warehouse      InventoryWarehouse             @relation(fields: [warehouseId], references: [id], onDelete: Restrict)
  requestId      String?
  request        InventoryRequest?              @relation(fields: [requestId], references: [id], onDelete: SetNull)
  requestLineId  String?
  requestLine    InventoryRequestLine?          @relation(fields: [requestLineId], references: [id], onDelete: SetNull)
  reportedById   String
  reportedBy     User                           @relation("InventoryConditionReporter", fields: [reportedById], references: [id], onDelete: Restrict)
  reviewedById   String?
  reviewedBy     User?                          @relation("InventoryConditionReviewer", fields: [reviewedById], references: [id], onDelete: Restrict)
  quantity       Decimal                        @db.Decimal(18, 4)
  description    String
  status         InventoryConditionReportStatus @default(SUBMITTED)
  resolutionNote String?
  reviewedAt     DateTime?
  resolvedAt     DateTime?
  createdAt      DateTime                       @default(now())
  updatedAt      DateTime                       @updatedAt

  stockMovements InventoryStockMovement[]

  @@index([organizationId, status, createdAt])
  @@map("inventory_condition_reports")
}

model InventoryStockMovement {
  id                String                     @id @default(uuid())
  organizationId    String
  organization      Organization               @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  assetId           String
  asset             InventoryAsset             @relation(fields: [assetId], references: [id], onDelete: Restrict)
  warehouseId       String
  warehouse         InventoryWarehouse         @relation(fields: [warehouseId], references: [id], onDelete: Restrict)
  requestId         String?
  request           InventoryRequest?          @relation(fields: [requestId], references: [id], onDelete: SetNull)
  requestLineId     String?
  requestLine       InventoryRequestLine?      @relation(fields: [requestLineId], references: [id], onDelete: SetNull)
  returnRequestId   String?
  returnRequest     InventoryReturnRequest?    @relation(fields: [returnRequestId], references: [id], onDelete: SetNull)
  conditionReportId String?
  conditionReport   InventoryConditionReport?  @relation(fields: [conditionReportId], references: [id], onDelete: SetNull)
  type              InventoryStockMovementType
  quantityDelta     Decimal                    @db.Decimal(18, 4)
  reason            String?
  actorId           String
  actor             User                       @relation(fields: [actorId], references: [id], onDelete: Restrict)
  occurredAt        DateTime                   @default(now())

  @@index([organizationId, assetId, occurredAt])
  @@index([organizationId, warehouseId, occurredAt])
  @@map("inventory_stock_movements")
}

/////////////////////////////////////////////////
// PROJECT MEMBERS
/////////////////////////////////////////////////

enum ProjectMemberRole {
  CONTRACTOR
  PROJECT_MANAGER
  SUPERVISOR
  SITE_ENGINEER
}

model ProjectMember {
  id String @id @default(uuid())

  projectId String
  project   Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  role ProjectMemberRole

  assignedAt DateTime  @default(now())
  removedAt  DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([projectId, userId])
  @@index([projectId])
  @@index([userId])
  @@map("project_members")
}

/////////////////////////////////////////////////
// PROJECT CUSTOMERS
/////////////////////////////////////////////////

enum ProjectCustomerRelationshipType {
  OWNER
  CLIENT
  DEVELOPER
  INVESTOR
  PARTNER
  OTHER
}

model ProjectCustomer {
  id String @id @default(uuid())

  projectId String
  project   Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  customerId String
  customer   Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)

  relationshipType ProjectCustomerRelationshipType

  isPrimary Boolean @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([projectId, customerId, relationshipType])
  @@index([projectId])
  @@index([customerId])
  @@map("project_customers")
}

/////////////////////////////////////////////////
// GLOBALS
/////////////////////////////////////////////////

model Profession {
  id          String  @id @default(uuid())
  name        String  @unique
  description String?
  isActive    Boolean @default(true)

  labours Labour[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("professions")
}

enum Weekday {
  MONDAY
  TUESDAY
  WEDNESDAY
  THURSDAY
  FRIDAY
  SATURDAY
  SUNDAY
}

enum LabourStatus {
  ACTIVE
  INACTIVE
}

model Labour {
  id String @id @default(uuid())

  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  professionId String
  profession   Profession @relation(fields: [professionId], references: [id], onDelete: Restrict)

  fullName String
  phone    String
  email    String?

  dateOfBirth DateTime?

  profileImageUrl String?

  country String
  city    String
  address String?

  emergencyContactName  String?
  emergencyContactPhone String?

  joiningDate DateTime?

  status LabourStatus @default(ACTIVE)

  notes String?

  assignments LabourAssignment[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([organizationId, phone])
  @@index([organizationId])
  @@index([organizationId, status])
  @@map("labours")
}

/////////////////////////////////////////////////
// CONTRACTOR
/////////////////////////////////////////////////

enum ContractorStatus {
  PENDING
  ACTIVE
  SUSPENDED
  INACTIVE
  TERMINATED
}

model Contractor {
  id String @id @default(uuid())

  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  contractorCode String @unique @default(dbgenerated("('CON-'::text || lpad((nextval('contractor_code_seq'::regclass))::text, 4, '0'::text))"))

  fullName String

  profileImageUrl String?

  email            String?
  phone            String
  alternativePhone String?

  country String
  city    String
  address String?

  nationalId        String?
  licenseNumber     String?
  licenseExpiryDate DateTime?

  status ContractorStatus @default(PENDING)

  notes String?

  projectAssignments ContractorProjectAssignment[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([organizationId, phone])
  @@unique([organizationId, email])
  @@index([organizationId])
  @@index([organizationId, status])
  @@map("contractors")
}

/////////////////////////////////////////////////
// CONTRACTOR PROJECT ASSIGNMENT
/////////////////////////////////////////////////

enum ContractorAssignmentStatus {
  PENDING
  ACTIVE
  ON_HOLD
  COMPLETED
  TERMINATED
  CANCELLED
}

model Responsibility {
  id          String  @id @default(uuid())
  name        String  @unique
  description String?
  isActive    Boolean @default(true)

  assignmentResponsibilities ContractorProjectAssignmentResponsibility[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("responsibilities")
}

model ContractorProjectAssignment {
  id String @id @default(uuid())

  projectId String
  project   Project @relation(fields: [projectId], references: [id], onDelete: Restrict)

  contractorId String
  contractor   Contractor @relation(fields: [contractorId], references: [id], onDelete: Restrict)

  responsibilities ContractorProjectAssignmentResponsibility[]

  scopeDescription String?

  startDate DateTime?
  endDate   DateTime?

  status ContractorAssignmentStatus @default(PENDING)
  notes  String?

  labourAssignments LabourAssignment[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([projectId, contractorId])
  @@index([projectId])
  @@index([contractorId])
  @@index([status])
  @@map("contractor_project_assignments")
}

model ContractorProjectAssignmentResponsibility {
  id String @id @default(uuid())

  assignmentId String
  assignment   ContractorProjectAssignment @relation(fields: [assignmentId], references: [id], onDelete: Cascade)

  responsibilityId String
  responsibility   Responsibility @relation(fields: [responsibilityId], references: [id], onDelete: Restrict)

  createdAt DateTime @default(now())

  @@unique([assignmentId, responsibilityId])
  @@index([assignmentId])
  @@index([responsibilityId])
  @@map("contractor_project_assignment_responsibilities")
}

/////////////////////////////////////////////////
// LABOUR ASSIGNMENT
/////////////////////////////////////////////////

enum LabourAssignmentStatus {
  ACTIVE
  COMPLETED
  CANCELLED
}

model LabourAssignment {
  id String @id @default(uuid())

  labourId String
  labour   Labour @relation(fields: [labourId], references: [id], onDelete: Restrict)

  contractorProjectAssignmentId String
  assignment                    ContractorProjectAssignment @relation(fields: [contractorProjectAssignmentId], references: [id], onDelete: Restrict)

  startDate DateTime
  endDate   DateTime

  status LabourAssignmentStatus @default(ACTIVE)

  notes String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  inventoryRequests InventoryRequest[]

  @@index([labourId])
  @@index([contractorProjectAssignmentId])
  @@index([status])
  @@index([startDate, endDate])
  @@map("labour_assignments")
}
