// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

/////////////////////////////////////////////////
// AUTHENTICATION
/////////////////////////////////////////////////

/////////////////////////////////////////////////
// ROLES
/////////////////////////////////////////////////

model Role {
  id String @id @default(uuid())

  name        String
  description String?

  // true  = global role created by SUPER_ADMIN
  // false = custom role created by ORGANIZATION_OWNER
  isGlobal Boolean @default(true)

  // NULL for global roles.
  // Set for organization-specific custom roles.
  organizationId String?
  organization   Organization? @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  organizationRoles OrganizationRole[]

  @@unique([name, organizationId])
  @@index([organizationId])
  @@map("roles")
}

model OrganizationRole {
  id String @id @default(uuid())

  organizationId String
  roleId         String

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  role Role @relation(fields: [roleId], references: [id], onDelete: Cascade)

  users User[]

  rolePermissions RolePermission[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([organizationId, roleId])
  @@index([organizationId])
  @@index([roleId])
  @@map("organization_roles")
}

enum Module {
  PROJECT
  LABOUR
  COMPANY
  CUSTOMER
  ATTENDANCE
  PAYROLL
  INVENTORY
  SUPPLIER
  REPORT
  ROLE
  USER
  CONTRACTOR
}

enum Action {
  CREATE
  VIEW
  UPDATE
  DELETE
  APPROVE
  EXPORT
  ASSIGN
}

model Permission {
  id String @id @default(uuid())

  module Module
  action Action

  description String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  rolePermissions RolePermission[]

  @@unique([module, action])
  @@map("permissions")
}

model RolePermission {
  id String @id @default(uuid())

  organizationRoleId String
  permissionId       String

  organizationRole OrganizationRole @relation(fields: [organizationRoleId], references: [id], onDelete: Cascade)

  permission Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@unique([organizationRoleId, permissionId])
  @@index([organizationRoleId])
  @@index([permissionId])
  @@map("role_permissions")
}

enum UserStatus {
  ACTIVE
  INACTIVE
  SUSPENDED
  PENDING
}

enum SystemRole {
  SUPER_ADMIN
}

model User {
  id String @id @default(uuid())

  fullName  String
  avatarUrl String?

  email String  @unique
  phone String? @unique

  password String

  status UserStatus @default(ACTIVE)

  emailVerified Boolean @default(false)
  phoneVerified Boolean @default(false)

  lastLoginAt DateTime?

  systemRole SystemRole?

  organizationId String?
  organization   Organization? @relation(fields: [organizationId], references: [id])

  organizationRoleId String?
  organizationRole   OrganizationRole? @relation(fields: [organizationRoleId], references: [id])

  refreshTokens RefreshToken[]

  projectMemberships ProjectMember[]

  createdStockDocuments StockDocument[] @relation("StockDocumentCreatedBy")
  postedStockDocuments StockDocument[] @relation("StockDocumentPostedBy")
  approvedStockDocuments StockDocument[] @relation("StockDocumentApprovedBy")
  rejectedStockDocuments StockDocument[] @relation("StockDocumentRejectedBy")
  cancelledStockDocuments StockDocument[] @relation("StockDocumentCancelledBy")
  stockMovements StockMovement[]
  createdAllocations ProjectMaterialAllocation[] @relation("AllocationCreatedBy")
  updatedAllocations ProjectMaterialAllocation[] @relation("AllocationUpdatedBy")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("users")
}

model RefreshToken {
  id String @id @default(uuid())

  token String @unique

  expiresAt DateTime
  revokedAt DateTime?

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@map("refresh_tokens")
}

/////////////////////////////////////////////////
// ORGANIZATION
/////////////////////////////////////////////////

model Organization {
  id          String  @id @default(uuid())
  name        String
  description String?

  users             User[]
  roles             Role[]
  organizationRoles OrganizationRole[]
  customers         Customer[]
  projects          Project[]
  labours           Labour[]
  contractors       Contractor[]

  inventoryCategories InventoryCategory[]
  inventoryAssets InventoryAsset[]
  inventoryItems InventoryItem[]
  warehouses Warehouse[]
  storageLocations StorageLocation[]
  stockBalances StockBalance[]
  stockDocuments StockDocument[]
  stockDocumentLines StockDocumentLine[]
  stockMovements StockMovement[]
  projectMaterialAllocations ProjectMaterialAllocation[]
  suppliers Supplier[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("organizations")
}

enum CustomerType {
  COMPANY
  GOVERNMENT
  INDIVIDUAL
  OTHER
}

/////////////////////////////////////////////////
// CUSTOMER
/////////////////////////////////////////////////

model Customer {
  id String @id @default(uuid())

  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  customerCode String @unique @default(dbgenerated("('CUS-'::text || lpad((nextval('customer_code_seq'::regclass))::text, 3, '0'::text))"))

  name            String
  type            CustomerType
  profileImageUrl String?

  country String
  city    String
  address String?

  parentCustomerId String?
  parentCustomer   Customer?  @relation("CustomerHierarchy", fields: [parentCustomerId, organizationId], references: [id, organizationId], onDelete: Cascade)
  childCustomers   Customer[] @relation("CustomerHierarchy")

  isActive Boolean @default(true)

  projectCustomers ProjectCustomer[]
  contacts         CustomerContact[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([id, organizationId])
  @@index([organizationId])
  @@index([parentCustomerId])
  @@map("customers")
}

model CustomerContact {
  id String @id @default(uuid())

  customerId String
  customer   Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)

  name            String
  designation     String
  phone           String
  otherPhone      String?
  email           String
  profileImageUrl String?
  isPrimary       Boolean @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([customerId])
  @@map("customer_contacts")
}

/////////////////////////////////////////////////
// PROJECT
/////////////////////////////////////////////////

enum ProjectStatus {
  PLANNING
  ACTIVE
  ON_HOLD
  COMPLETED
  CANCELLED
}

model Project {
  id String @id @default(uuid())

  projectCode String  @unique @default(dbgenerated("('PROJ-'::text || lpad((nextval('project_code_seq'::regclass))::text, 6, '0'::text))"))
  name        String
  description String?
  imageUrl    String?

  status ProjectStatus @default(PLANNING)

  // Organization that owns/manages the project
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)

  // Location
  country   String
  city      String?
  address   String?
  latitude  Decimal? @db.Decimal(10, 7)
  longitude Decimal? @db.Decimal(10, 7)

  // Timeline
  plannedStartDate DateTime?
  plannedEndDate   DateTime?
  actualStartDate  DateTime?
  actualEndDate    DateTime?

  // Progress
  progress Int @default(0)

  // Financial
  budget Decimal? @db.Decimal(15, 2)

  projectCustomers ProjectCustomer[]

  members               ProjectMember[]
  contractorAssignments ContractorProjectAssignment[]
  projectWarehouses Warehouse[]
  materialAllocations ProjectMaterialAllocation[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([organizationId])
  @@index([status])
  @@unique([id, organizationId])
  @@map("projects")
}

/////////////////////////////////////////////////
// INVENTORY FOUNDATION
/////////////////////////////////////////////////

enum WarehouseType {
  CENTRAL
  PROJECT_SITE
}

enum StockDocumentType {
  RECEIPT
  ISSUE
  TRANSFER
  ADJUSTMENT
}

enum StockDocumentStatus {
  DRAFT
  PENDING_APPROVAL
  POSTED
  REJECTED
  CANCELLED
}

enum StockMovementType {
  RECEIPT
  ISSUE
  TRANSFER_OUT
  TRANSFER_IN
  ADJUSTMENT_IN
  ADJUSTMENT_OUT
}

enum ProjectMaterialAllocationStatus {
  ACTIVE
  CONSUMED
  RELEASED
  CLOSED
}

enum InventoryAssetType {
  MATERIAL
  TOOL
  MACHINERY
}

model InventoryAsset {
  id String @id @default(uuid())
  organizationId String
  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  type InventoryAssetType
  code String
  name String
  quantity Decimal @default(0) @db.Decimal(18, 4)
  price Decimal @default(0) @db.Decimal(18, 4)
  description String?
  imageUrl String?
  isActive Boolean @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([organizationId, code])
  @@index([organizationId, type, isActive])
  @@index([organizationId, name])
  @@map("inventory_assets")
}

model InventoryCategory {
  id String @id @default(uuid())
  organizationId String
  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  name String
  description String?
  parentCategoryId String?
  parentCategory InventoryCategory? @relation("InventoryCategoryTree", fields: [parentCategoryId, organizationId], references: [id, organizationId], onDelete: Restrict)
  childCategories InventoryCategory[] @relation("InventoryCategoryTree")
  isActive Boolean @default(true)
  items InventoryItem[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  @@unique([id, organizationId])
  @@unique([organizationId, name])
  @@index([organizationId])
  @@map("inventory_categories")
}

model UnitOfMeasure {
  id String @id @default(uuid())
  code String @unique
  name String
  symbol String
  precision Int @default(4)
  isActive Boolean @default(true)
  items InventoryItem[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  @@map("units_of_measure")
}

model InventoryItem {
  id String @id @default(uuid())
  organizationId String
  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  sku String
  name String
  description String?
  categoryId String?
  category InventoryCategory? @relation(fields: [categoryId, organizationId], references: [id, organizationId], onDelete: Restrict)
  unitOfMeasureId String
  unitOfMeasure UnitOfMeasure @relation(fields: [unitOfMeasureId], references: [id], onDelete: Restrict)
  reorderLevel Decimal @default(0) @db.Decimal(18, 4)
  defaultCost Decimal? @db.Decimal(18, 4)
  isActive Boolean @default(true)
  stockBalances StockBalance[]
  stockDocumentLines StockDocumentLine[]
  stockMovements StockMovement[]
  materialAllocations ProjectMaterialAllocation[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  @@unique([id, organizationId])
  @@unique([organizationId, sku])
  @@index([organizationId])
  @@index([organizationId, categoryId])
  @@map("inventory_items")
}

model Warehouse {
  id String @id @default(uuid())
  organizationId String
  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  code String
  name String
  type WarehouseType @default(CENTRAL)
  projectId String?
  project Project? @relation(fields: [projectId, organizationId], references: [id, organizationId], onDelete: Restrict)
  address String?
  isActive Boolean @default(true)
  storageLocations StorageLocation[]
  stockBalances StockBalance[]
  sourceDocumentLines StockDocumentLine[] @relation("StockLineSourceWarehouse")
  destinationDocumentLines StockDocumentLine[] @relation("StockLineDestinationWarehouse")
  stockMovements StockMovement[]
  materialAllocations ProjectMaterialAllocation[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  @@unique([id, organizationId])
  @@unique([organizationId, code])
  @@index([organizationId])
  @@index([organizationId, projectId])
  @@map("warehouses")
}

model StorageLocation {
  id String @id @default(uuid())
  organizationId String
  warehouseId String
  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  warehouse Warehouse @relation(fields: [warehouseId, organizationId], references: [id, organizationId], onDelete: Restrict)
  code String
  name String
  isActive Boolean @default(true)
  stockBalances StockBalance[]
  sourceDocumentLines StockDocumentLine[] @relation("StockLineSourceLocation")
  destinationDocumentLines StockDocumentLine[] @relation("StockLineDestinationLocation")
  stockMovements StockMovement[]
  materialAllocations ProjectMaterialAllocation[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  @@unique([id, organizationId])
  @@unique([id, warehouseId, organizationId])
  @@unique([warehouseId, code])
  @@index([organizationId])
  @@index([warehouseId])
  @@map("storage_locations")
}

model StockBalance {
  id String @id @default(uuid())
  organizationId String
  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  itemId String
  item InventoryItem @relation(fields: [itemId, organizationId], references: [id, organizationId], onDelete: Restrict)
  warehouseId String
  warehouse Warehouse @relation(fields: [warehouseId, organizationId], references: [id, organizationId], onDelete: Restrict)
  storageLocationId String?
  storageLocation StorageLocation? @relation(fields: [storageLocationId, warehouseId, organizationId], references: [id, warehouseId, organizationId], onDelete: Restrict)
  onHandQty Decimal @default(0) @db.Decimal(18, 4)
  reservedQty Decimal @default(0) @db.Decimal(18, 4)
  weightedAverageUnitCost Decimal @default(0) @db.Decimal(18, 4)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  @@unique([id, organizationId])
  @@index([organizationId])
  @@index([organizationId, itemId])
  @@index([organizationId, warehouseId])
  @@index([organizationId, warehouseId, storageLocationId])
  @@map("stock_balances")
}

model StockDocument {
  id String @id @default(uuid())
  organizationId String
  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  referenceNumber String
  type StockDocumentType
  status StockDocumentStatus @default(DRAFT)
  reason String?
  externalReference String?
  supplierId String?
  supplier Supplier? @relation(fields: [supplierId, organizationId], references: [id, organizationId], onDelete: Restrict)
  idempotencyKey String?
  createdById String
  createdBy User @relation("StockDocumentCreatedBy", fields: [createdById], references: [id], onDelete: Restrict)
  postedById String?
  postedBy User? @relation("StockDocumentPostedBy", fields: [postedById], references: [id], onDelete: Restrict)
  approvedById String?
  approvedBy User? @relation("StockDocumentApprovedBy", fields: [approvedById], references: [id], onDelete: Restrict)
  rejectedById String?
  rejectedBy User? @relation("StockDocumentRejectedBy", fields: [rejectedById], references: [id], onDelete: Restrict)
  cancelledById String?
  cancelledBy User? @relation("StockDocumentCancelledBy", fields: [cancelledById], references: [id], onDelete: Restrict)
  postedAt DateTime?
  approvedAt DateTime?
  rejectedAt DateTime?
  cancelledAt DateTime?
  lines StockDocumentLine[]
  movements StockMovement[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  @@unique([id, organizationId])
  @@unique([organizationId, referenceNumber])
  @@unique([organizationId, idempotencyKey])
  @@index([organizationId, type, status])
  @@index([organizationId, createdAt])
  @@map("stock_documents")
}

model StockDocumentLine {
  id String @id @default(uuid())
  organizationId String
  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  documentId String
  document StockDocument @relation(fields: [documentId, organizationId], references: [id, organizationId], onDelete: Restrict)
  itemId String
  item InventoryItem @relation(fields: [itemId, organizationId], references: [id, organizationId], onDelete: Restrict)
  allocationId String?
  allocation ProjectMaterialAllocation? @relation(fields: [allocationId, organizationId], references: [id, organizationId], onDelete: Restrict)
  quantity Decimal @db.Decimal(18, 4)
  unitCost Decimal @default(0) @db.Decimal(18, 4)
  sourceWarehouseId String?
  sourceWarehouse Warehouse? @relation("StockLineSourceWarehouse", fields: [sourceWarehouseId, organizationId], references: [id, organizationId], onDelete: Restrict)
  sourceStorageLocationId String?
  sourceStorageLocation StorageLocation? @relation("StockLineSourceLocation", fields: [sourceStorageLocationId, sourceWarehouseId, organizationId], references: [id, warehouseId, organizationId], onDelete: Restrict)
  destinationWarehouseId String?
  destinationWarehouse Warehouse? @relation("StockLineDestinationWarehouse", fields: [destinationWarehouseId, organizationId], references: [id, organizationId], onDelete: Restrict)
  destinationStorageLocationId String?
  destinationStorageLocation StorageLocation? @relation("StockLineDestinationLocation", fields: [destinationStorageLocationId, destinationWarehouseId, organizationId], references: [id, warehouseId, organizationId], onDelete: Restrict)
  movements StockMovement[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  @@unique([id, organizationId])
  @@index([organizationId, documentId])
  @@index([organizationId, itemId])
  @@map("stock_document_lines")
}

model StockMovement {
  id String @id @default(uuid())
  organizationId String
  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  itemId String
  item InventoryItem @relation(fields: [itemId, organizationId], references: [id, organizationId], onDelete: Restrict)
  warehouseId String
  warehouse Warehouse @relation(fields: [warehouseId, organizationId], references: [id, organizationId], onDelete: Restrict)
  storageLocationId String?
  storageLocation StorageLocation? @relation(fields: [storageLocationId, warehouseId, organizationId], references: [id, warehouseId, organizationId], onDelete: Restrict)
  documentId String
  document StockDocument @relation(fields: [documentId, organizationId], references: [id, organizationId], onDelete: Restrict)
  documentLineId String?
  documentLine StockDocumentLine? @relation(fields: [documentLineId, organizationId], references: [id, organizationId], onDelete: Restrict)
  type StockMovementType
  quantityDelta Decimal @db.Decimal(18, 4)
  unitCost Decimal @db.Decimal(18, 4)
  actorId String
  actor User @relation(fields: [actorId], references: [id], onDelete: Restrict)
  idempotencyKey String?
  occurredAt DateTime @default(now())
  @@unique([organizationId, idempotencyKey])
  @@index([organizationId, itemId, occurredAt])
  @@index([organizationId, warehouseId, occurredAt])
  @@index([organizationId, documentId])
  @@map("stock_movements")
}

model ProjectMaterialAllocation {
  id String @id @default(uuid())
  organizationId String
  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  projectId String
  project Project @relation(fields: [projectId, organizationId], references: [id, organizationId], onDelete: Restrict)
  itemId String
  item InventoryItem @relation(fields: [itemId, organizationId], references: [id, organizationId], onDelete: Restrict)
  warehouseId String
  warehouse Warehouse @relation(fields: [warehouseId, organizationId], references: [id, organizationId], onDelete: Restrict)
  storageLocationId String?
  storageLocation StorageLocation? @relation(fields: [storageLocationId, warehouseId, organizationId], references: [id, warehouseId, organizationId], onDelete: Restrict)
  allocatedQty Decimal @db.Decimal(18, 4)
  consumedQty Decimal @default(0) @db.Decimal(18, 4)
  releasedQty Decimal @default(0) @db.Decimal(18, 4)
  status ProjectMaterialAllocationStatus @default(ACTIVE)
  createdById String
  createdBy User @relation("AllocationCreatedBy", fields: [createdById], references: [id], onDelete: Restrict)
  updatedById String?
  updatedBy User? @relation("AllocationUpdatedBy", fields: [updatedById], references: [id], onDelete: Restrict)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  stockDocumentLines StockDocumentLine[]
  @@unique([id, organizationId])
  @@index([organizationId, projectId])
  @@index([organizationId, itemId])
  @@index([organizationId, warehouseId])
  @@index([organizationId, warehouseId, storageLocationId])
  @@map("project_material_allocations")
}

model Supplier {
  id String @id @default(uuid())
  organizationId String
  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  supplierCode String?
  name String
  contactName String?
  email String?
  phone String?
  address String?
  isActive Boolean @default(true)
  stockDocuments StockDocument[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  @@unique([id, organizationId])
  @@unique([organizationId, supplierCode])
  @@index([organizationId])
  @@map("suppliers")
}

/////////////////////////////////////////////////
// PROJECT MEMBERS
/////////////////////////////////////////////////

enum ProjectMemberRole {
  CONTRACTOR
  PROJECT_MANAGER
  SUPERVISOR
  SITE_ENGINEER
}

model ProjectMember {
  id String @id @default(uuid())

  projectId String
  project   Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  role ProjectMemberRole

  assignedAt DateTime  @default(now())
  removedAt  DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([projectId, userId])
  @@index([projectId])
  @@index([userId])
  @@map("project_members")
}

/////////////////////////////////////////////////
// PROJECT CUSTOMERS
/////////////////////////////////////////////////

enum ProjectCustomerRelationshipType {
  OWNER
  CLIENT
  DEVELOPER
  INVESTOR
  PARTNER
  OTHER
}

model ProjectCustomer {
  id String @id @default(uuid())

  projectId String
  project   Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  customerId String
  customer   Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)

  relationshipType ProjectCustomerRelationshipType

  isPrimary Boolean @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([projectId, customerId, relationshipType])
  @@index([projectId])
  @@index([customerId])
  @@map("project_customers")
}

/////////////////////////////////////////////////
// GLOBALS
/////////////////////////////////////////////////

model Profession {
  id          String  @id @default(uuid())
  name        String  @unique
  description String?
  isActive    Boolean @default(true)

  labours Labour[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("professions")
}

enum Weekday {
  MONDAY
  TUESDAY
  WEDNESDAY
  THURSDAY
  FRIDAY
  SATURDAY
  SUNDAY
}

enum LabourStatus {
  ACTIVE
  INACTIVE
}

model Labour {
  id String @id @default(uuid())

  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  professionId String
  profession   Profession @relation(fields: [professionId], references: [id], onDelete: Restrict)

  fullName String
  phone    String
  email    String?

  dateOfBirth DateTime?

  profileImageUrl String?

  country String
  city    String
  address String?

  emergencyContactName  String?
  emergencyContactPhone String?

  joiningDate DateTime?

  status LabourStatus @default(ACTIVE)

  notes String?

  assignments LabourAssignment[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([organizationId, phone])
  @@index([organizationId])
  @@index([organizationId, status])
  @@map("labours")
}

/////////////////////////////////////////////////
// CONTRACTOR
/////////////////////////////////////////////////

enum ContractorStatus {
  PENDING
  ACTIVE
  SUSPENDED
  INACTIVE
  TERMINATED
}

model Contractor {
  id String @id @default(uuid())

  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  contractorCode String @unique @default(dbgenerated("('CON-'::text || lpad((nextval('contractor_code_seq'::regclass))::text, 4, '0'::text))"))

  fullName String

  profileImageUrl String?

  email            String?
  phone            String
  alternativePhone String?

  country String
  city    String
  address String?

  nationalId        String?
  licenseNumber     String?
  licenseExpiryDate DateTime?

  status ContractorStatus @default(PENDING)

  notes String?

  projectAssignments ContractorProjectAssignment[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([organizationId, phone])
  @@unique([organizationId, email])
  @@index([organizationId])
  @@index([organizationId, status])
  @@map("contractors")
}

/////////////////////////////////////////////////
// CONTRACTOR PROJECT ASSIGNMENT
/////////////////////////////////////////////////

enum ContractorAssignmentStatus {
  PENDING
  ACTIVE
  ON_HOLD
  COMPLETED
  TERMINATED
  CANCELLED
}

model Responsibility {
  id          String  @id @default(uuid())
  name        String  @unique
  description String?
  isActive    Boolean @default(true)

  assignmentResponsibilities ContractorProjectAssignmentResponsibility[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("responsibilities")
}

model ContractorProjectAssignment {
  id String @id @default(uuid())

  projectId String
  project   Project @relation(fields: [projectId], references: [id], onDelete: Restrict)

  contractorId String
  contractor   Contractor @relation(fields: [contractorId], references: [id], onDelete: Restrict)

  responsibilities ContractorProjectAssignmentResponsibility[]

  scopeDescription String?

  startDate DateTime?
  endDate   DateTime?

  status ContractorAssignmentStatus @default(PENDING)
  notes  String?

  labourAssignments LabourAssignment[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([projectId, contractorId])
  @@index([projectId])
  @@index([contractorId])
  @@index([status])
  @@map("contractor_project_assignments")
}

model ContractorProjectAssignmentResponsibility {
  id String @id @default(uuid())

  assignmentId String
  assignment   ContractorProjectAssignment @relation(fields: [assignmentId], references: [id], onDelete: Cascade)

  responsibilityId String
  responsibility   Responsibility @relation(fields: [responsibilityId], references: [id], onDelete: Restrict)

  createdAt DateTime @default(now())

  @@unique([assignmentId, responsibilityId])
  @@index([assignmentId])
  @@index([responsibilityId])
  @@map("contractor_project_assignment_responsibilities")
}

/////////////////////////////////////////////////
// LABOUR ASSIGNMENT
/////////////////////////////////////////////////

enum LabourAssignmentStatus {
  ACTIVE
  COMPLETED
  CANCELLED
}

model LabourAssignment {
  id String @id @default(uuid())

  labourId String
  labour   Labour @relation(fields: [labourId], references: [id], onDelete: Restrict)

  contractorProjectAssignmentId String
  assignment                    ContractorProjectAssignment @relation(fields: [contractorProjectAssignmentId], references: [id], onDelete: Restrict)

  startDate DateTime
  endDate   DateTime

  status LabourAssignmentStatus @default(ACTIVE)

  notes String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([labourId])
  @@index([contractorProjectAssignmentId])
  @@index([status])
  @@index([startDate, endDate])
  @@map("labour_assignments")
}
